Attribute VB_Name = "monitor1"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Dim X As Integer, Y As Integer
Dim gx(152) As Double, gy(152) As Double
Dim rr As ColorConstants

' zeichne eine willkürliche, Kennlinien - ähnliche Kurve
Private Sub Form_Load()
    
    gx(0) = 0
    gy(0) = 220
   
    
    gx(1) = 200
    gy(1) = 220
    
    For i = 0 To 149
        gx(2 + i) = 201 + i
        gy(i + 2) = (1000 / (i + 30)) + 187
    Next i
    
    gx(152) = 350
    gy(152) = 0
    
    sc3.PlotXvsY gx, gy
    
    sc3.Cursors(1).Color = vbRed
    sc3.Cursors(1).XPosition = 100
    sc3.Cursors(1).XPosition = 100

End Sub

Private Sub raus_Click()
    Unload Me
End Sub


' Zeige an, ob Klick innerhalb oder ausserhalb Kennlinien-Fläche, anhand der Information darüber..
'..aus den Eckwerten der oben definierten Kurve
Private Sub sc3_Click()
    X = Int(sc3.Cursors(1).XPosition)
    Y = Int(sc3.Cursors(1).yPosition)
    tx.Text = X
    ty.Text = Y

    rr = vbBlack
    
    If X < 100 Then rr = vbRed
    If X > 350 Then rr = vbRed
    If 100 < X < 200 And (Y < 80 Or Y > 220) Then rr = vbRed
    If X >= 200 And X <= 350 Then
    For i = 2 To 151
       If (X = gx(i)) And Y > gy(i) Or Y < 80 Then rr = vbRed
    Next i
    End If
     
    sc3.Cursors(1).Color = rr
    sc3.Cursors(1).SetPosition X, Y
    
End Sub


' Erzeuge zufällige Position für Cursor, zeige an ob inner- oder ausserhalb Kennlinien - Fläche, anhand..
'..der Informationen darüber aus den Eckwerten der oben definierten Kurve
Private Sub Timer1_Timer()
    
    X = Int(Rnd(1) * 500)
    Y = Int(Rnd(1) * 250)
    tx.Text = X
    ty.Text = Y

    rr = vbBlack
   
    If X > 350 Then rr = vbRed
    If 100 < X < 200 And (Y > 220) Then rr = vbRed
    If X >= 200 And X <= 350 Then
    For i = 2 To 151
       If (X = gx(i)) And Y > gy(i) Then rr = vbRed
    Next i
    End If
     
    sc3.Cursors(1).Color = rr
    sc3.Cursors(1).SetPosition X, Y

End Sub
